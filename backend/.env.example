DJANGO_SECRET_KEY=replace-with-a-development-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=academic_research_assistant
POSTGRES_USER=academic_research_assistant
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DOCUMENT_UPLOAD_MAX_BYTES=10485760
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_ONNX_MODEL_PATH=
EMBEDDING_ONNX_TOKENIZER_PATH=
EMBEDDING_ONNX_BATCH_SIZE=8
EMBEDDING_ONNX_MAX_SEQUENCE_LENGTH=256
EMBEDDING_ONNX_INTRA_OP_THREADS=1
EMBEDDING_ONNX_INTER_OP_THREADS=1
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-api-key
LLM_MODEL=openai/gpt-oss-20b
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONTEXT_CHARS=12000
LLM_MAX_SOURCE_CHARS=2500
LLM_MAX_OUTPUT_TOKENS=700
LLM_MODEL_CONTEXT_WINDOW=131072
LLM_PROMPT_OVERHEAD_TOKENS=1200
LLM_QUESTION_MAX_CHARS=1000
LLM_ASK_TOP_K_MAX=10
LLM_TEMPERATURE=0.1
LLM_ASK_THROTTLE_RATE=10/minute
LLM_GROQ_SUPPORTED_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,llama-3.1-8b-instant,llama-3.3-70b-versatile
